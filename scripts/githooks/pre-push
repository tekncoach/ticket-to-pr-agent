#!/usr/bin/env bash
# The gate, where its data lives.
#
# CI cannot run the golden set: the corpus (data/kb/) and the target checkout
# are both absent from a stateless runner by design — the corpus cites sources
# that are not ours to redistribute, and the checkout is built into the image,
# not the repository. So the eval half of the gate runs here, on a machine that
# has them, and CI keeps the half that is genuinely hermetic.
#
# Install: make hooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() { echo "pre-push: $1" >&2; echo "pre-push: push refused. --no-verify overrides." >&2; exit 1; }

echo "pre-push: lint"
if ! lint_out=$(make lint 2>&1); then
  printf '%s\n' "$lint_out" | tail -40 >&2
  fail "the linter found something"
fi

echo "pre-push: unit suite"
# The output is kept and shown on failure: a refusal that does not say which
# test failed cannot be acted on, and the reader's only move is --no-verify.
if ! suite_out=$(make test 2>&1); then
  printf '%s\n' "$suite_out" | tail -40 >&2
  fail "the hermetic suite is red"
fi

echo "pre-push: frozen golden set"
uv run python -m evals.freeze --check || fail "golden.jsonl has drifted from its lock"

