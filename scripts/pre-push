#!/usr/bin/env bash
# The gate, where its data lives.
#
# CI cannot run the golden set: the corpus (data/kb/) and the target checkout
# are both absent from a stateless runner by design — the corpus cites sources
# that are not ours to redistribute, and the checkout is built into the image,
# not the repository. So the eval half of the gate runs here, on a machine that
# has them, and CI keeps the half that is genuinely hermetic.
#
# Install: make hooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() { echo "pre-push: $1" >&2; echo "pre-push: push refused. --no-verify overrides." >&2; exit 1; }

echo "pre-push: unit suite"
make test >/dev/null 2>&1 || fail "the hermetic suite is red"

echo "pre-push: frozen golden set"
uv run python -m evals.freeze --check || fail "golden.jsonl has drifted from its lock"

# Skipped loudly, never silently: a hook that quietly does nothing is a hook
# everyone believes is running.
if [ ! -f data/kb/kb.sqlite3 ]; then
  echo "pre-push: SKIPPED the eval gate — no corpus at data/kb/kb.sqlite3 (make ingest)"
  exit 0
fi
if [ ! -f .env ]; then
  echo "pre-push: SKIPPED the eval gate — no .env"
  exit 0
fi

# Out of the tree: a hook that leaves a new file behind on every push makes
# git status noise, and noise is what stops being read.
export EVAL_RESULTS_DIR="$(mktemp -d)"
echo "pre-push: eval gate (retrieval tier, no model, free)"
make golden TIER=retrieval || fail "the eval gate refused this run"
rm -rf "$EVAL_RESULTS_DIR"
