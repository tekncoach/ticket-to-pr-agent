# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Virtual envs
.venv/
venv/
.uv/

# Secrets & local env — never commit real keys
.env
.env.*
!.env.example

# Data: fixtures are committed deliberately; everything else stays local
data/*
!data/.gitkeep
# rag/build_corpus.py's real manifest names local machine paths, some
# outside this repo entirely (private research notes) — never committed.
# The example/template below is, same pattern as .env vs .env.example.
!data/kb/
data/kb/*
!data/kb/manifest.example.json

# Editors / OS
.DS_Store
.idea/
.vscode/

# Playwright MCP scratch
.playwright-mcp/
workspace/

# Per-run session logs (JSONL, one file per run_id) — local debugging/eval
# fodder, not source
tmp/
