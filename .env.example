# Copy to .env and fill in real values. .env is gitignored — never commit keys.

# --- LLM (Anthropic API, metered) ---
# The raw Anthropic SDK uses a metered API key from https://platform.claude.com/.
# The Claude Max/Pro subscription cannot power this SDK — it only works with the
# Claude Agent SDK / Claude Code — so this is an API key, not an OAuth token.
LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
LLM_MODEL=claude-haiku-4-5         # POC default; raise to claude-sonnet-5 / -opus-5 if the CI-pass rate stalls

# --- Retrieval (wired on Day 4) ---
VECTOR_URL=postgresql://localhost:5432/ticket_to_pr

# --- Rollout / ops ---
SHADOW_MODE=true                   # agent proposes, never writes for real, until we flip it
LOG_LEVEL=INFO

# --- Tool credentials (stubs until Day 5) ---
# GitHub: repo + Issues (tickets) + PR API + Actions (CI)
# for tekncoach/liberty-rider-myroadtrips
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
