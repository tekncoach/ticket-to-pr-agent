# Copy to .env and fill in real values. .env is gitignored — never commit keys.
#
# No inline comments after a value. `docker run --env-file` does not strip them
# and reads them as part of the value — LLM_MODEL once arrived in a container as
# "claude-haiku-4-5   # POC default; raise to...". docker compose and uv both
# strip correctly, so this only bites on the ad-hoc path, which is exactly the
# one someone reaches for in a hurry. Comments go on their own line.

# --- LLM (Anthropic API, metered) ---
# The raw Anthropic SDK uses a metered API key from https://platform.claude.com/.
# The Claude Max/Pro subscription cannot power this SDK — it only works with the
# Claude Agent SDK / Claude Code — so this is an API key, not an OAuth token.
LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# POC default; raise to claude-sonnet-5 / -opus-5 if the CI-pass rate stalls
LLM_MODEL=claude-haiku-4-5
# must exceed THINKING_BUDGET_TOKENS if thinking is enabled
MAX_TOKENS=1024
# turn budget: max edit→test cycles before the agent gives up
MAX_TURNS=8
# prepared, off by default — see agent/runtime.py's ADAPTIVE_THINKING_MODELS
THINKING_ENABLED=false
# only used on the budget_tokens path (Haiku-style models); needs MAX_TOKENS raised too
THINKING_BUDGET_TOKENS=2048

# --- Retrieval ---
# Embeddings: Hugging Face Inference Providers (feature-extraction task).
# Token needs ONLY the "Inference Providers" permission (inference.serverless.write) —
# generate one at https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_TOKEN=hf_xxxxxxxxxxxxxxxx
# multilingual — the corpus mixes French and English sources
EMBEDDING_MODEL=BAAI/bge-m3
# Vector store: sqlite-vec, a single local file — no server, no Postgres/pgvector.
# See docs/SPEC.md's Deferred architecture decisions for why, and the upgrade path (Qdrant local mode).
VECTOR_DB_PATH=data/kb/kb.sqlite3

# --- Rollout / ops ---
# agent proposes, never writes for real, until we flip it
SHADOW_MODE=true
LOG_LEVEL=INFO

# --- Target repo ---
# owner/repo the agent reads tickets from and opens PRs against. One repo
# for now — agent/config.py is the seam a future multi-repo setup would use.
TARGET_REPO=tekncoach/liberty-rider-myroadtrips
# Local working copy path. Defaults to workspace/<repo-name> if unset.
# TARGET_WORKSPACE=/path/to/somewhere/else
# The target repo pins its own dependencies, so run_tests uses its venv, not
# ours. Defaults to <workspace>/.venv/bin/python; create it with
#   uv venv --python 3.12 .venv && uv pip install -r requirements-dev.txt
# inside the checkout. The Docker image does this at build time.
# TARGET_PYTHON=/path/to/checkout/.venv/bin/python
# what open_pr targets its draft PRs at
TARGET_BASE_BRANCH=main

# --- Serving ---
# inside the container
PORT=8000
# what deploy/docker-compose.yml publishes
# HOST_PORT=8000

# --- Tool credentials ---
# GitHub: repo + Issues (tickets) + PR API + Actions (CI), for TARGET_REPO above
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
