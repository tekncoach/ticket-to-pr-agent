# Copy to .env and fill in real values. .env is gitignored — never commit keys.

# --- LLM (Anthropic API, metered) ---
# The raw Anthropic SDK uses a metered API key from https://platform.claude.com/.
# The Claude Max/Pro subscription cannot power this SDK — it only works with the
# Claude Agent SDK / Claude Code — so this is an API key, not an OAuth token.
LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
LLM_MODEL=claude-haiku-4-5         # POC default; raise to claude-sonnet-5 / -opus-5 if the CI-pass rate stalls
MAX_TOKENS=1024                    # must exceed THINKING_BUDGET_TOKENS if thinking is enabled
MAX_TURNS=8                        # turn budget: max edit→test cycles before the agent gives up
THINKING_ENABLED=false             # prepared, off by default — see agent/runtime.py's ADAPTIVE_THINKING_MODELS
THINKING_BUDGET_TOKENS=2048        # only used on the budget_tokens path (Haiku-style models); needs MAX_TOKENS raised too

# --- Retrieval (wired on Day 4) ---
VECTOR_URL=postgresql://localhost:5432/ticket_to_pr

# --- Rollout / ops ---
SHADOW_MODE=true                   # agent proposes, never writes for real, until we flip it
LOG_LEVEL=INFO

# --- Target repo ---
# owner/repo the agent reads tickets from and opens PRs against. One repo
# for now — agent/config.py is the seam a future multi-repo setup would use.
TARGET_REPO=tekncoach/liberty-rider-myroadtrips
# Local working copy path. Defaults to workspace/<repo-name> if unset.
# TARGET_WORKSPACE=/path/to/somewhere/else

# --- Tool credentials (stubs until Day 5) ---
# GitHub: repo + Issues (tickets) + PR API + Actions (CI), for TARGET_REPO above
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
